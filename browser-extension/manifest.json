{
  "manifest_version": 3,
  "name": "OmniKey Vault Bridge",
  "version": "2.4.0",
  "description": "OmniKey Vault 桥接 — 搜索条目、自动填充网页表单、复制到剪贴板",
  "permissions": ["activeTab", "storage", "clipboardWrite", "scripting"],
  "host_permissions": ["http://127.0.0.1:14725/*", "http://127.0.0.1:*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
